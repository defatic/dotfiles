#!/usr/bin/env bash
#
# Reminders does not persist after reboot

set -e

[[ ! "$(command -v jq)" ]] && echo "Install jq" && exit 1
[[ ! "$(command -v awk)" ]] && echo "Install awk" && exit 1

commands="show clear term "

if [[ -n "$COMP_LINE" ]]; then
  pre="${COMP_LINE##* }"
  for c in ${commands}; do
    [[ -z "${pre}" || "${c}" != "${c#"${pre}"}" ]] && echo "$c"
  done
  exit
fi


formatRemaining() {
    local seconds="${1}"
    local minutes=$((seconds / 60))
    local remainder=$((seconds % 60))

    if ((minutes > 0 && remainder > 0)); then
        echo "${minutes}m ${remainder}s"
    elif ((minutes > 0)); then
        echo "${minutes}m"
    else
        echo "${remainder}s"
    fi
}

activeReminderTimers() {
    local now=${1:-$(date +%s)}
    local timer next

    while IFS=$'\t' read -r timer next; do
        [[ -z "${timer}" || -z "${next}" ]] && continue

        next=$((next / 1000000 ))
        ((next <= now)) && continue

        printf "%s\t%s\n" "${timer}" "${next}"
    done < <(systemctl --user list-timers --all --output=json "reminders-*.timer" 2>/dev/null | jq -r '.[] | [.unit, .next] | @tsv')
}

showReminders() {
  local timer next remaining reminder reminderMinutes body=""
  local reminderDir="${XDG_RUNTIME_DIR:-/tmp}/reminders"
  local reminderMessage=""
  local now=$(date +%s)

  while IFS=$'\t' read -r timer next; do
    remaining=$((next - now))
    reminder=${timer%.timer}
    reminder=${reminder#omarchy-reminder-}
    reminderMinutes=${reminder%%m-*}
    reminderMessage=""
    [[ -f ${reminderDir}/${timer%.timer}.message ]] && reminderMessage=$(<"${reminderDir}/${timer%.timer}.message")

    if [[ -n "${reminderMessage}" ]]; then
      body+="${reminderMessage} in $(formatRemaining ${remaining}) ($(date -d "@${next}" +%-H:%M:%S))"$'\n'
    else
      body+="${reminderMinutes}-min reminder in $(formatRemaining ${remaining}) ($(date -d "@${next}" +%-H:%M:%S))"$'\n'
    fi
  done < <(activeReminderTimers "${now}")

  if [[ "${1}" == "s" ]]; then
      if [[ -z "${body}" ]]; then
        echo -e "Upcoming reminders\nNo outstanding reminders"
      else
        echo -e "Upcoming reminders\n${body%$'\n'}"
      fi

      exit 5
  fi

  if [[ -z "${body}" ]]; then
    notify-send -i 󰢌 "Upcoming reminders" "No outstanding reminders"
  else
    notify-send -i 󰢌 "Upcoming reminders" "${body%$'\n'}"
  fi
}

clearReminders() {
    local units
    local remindersDir="${XDG_RUNTIME_DIR:-/tmp}/reminders"

    units=$(systemctl --user list-timers --all --no-legend --no-pager "reminders-*.timer" 2>/dev/null | awk '{ print $(NF - 1), $NF }')

    if [[ -n "${units}" ]]; then
        xargs -r systemctl --user stop <<<"${units}" 2>/dev/null || true
    fi

    rm -f "${remindersDir}"/reminders-*.message 2>/dev/null || true
    notify-send "Cleared!" "All reminders have been cleared"
}

activeReminders() {
    local cmd=$(systemctl --user list-timers --all --output=json "reminders-*.timer" 2>/dev/null | jq -r '.[] | [.unit, .next] | @tsv' | wc -l)

    if (( cmd > 0 )); then
        printf "%s" "${cmd}"
    else
        cmd=0
        printf "%s" "${cmd}"
    fi
}

case "$*" in
    show)
        showReminders
        exit 0
        ;;
    term)
        showReminders s
        exit 0
        ;;
    clear)
        clearReminders
        exit 0
        ;;
    ar)
        activeReminders
        exit 0
        ;;
    *) 
        : ;;
esac

minutes=${1}
shift
message="$*"

if [[ -z "${minutes}" ]] || [[ ! "${minutes}" =~ ^[0-9]+$ ]] || ((minutes <= 0)); then
    echo "Useage: reminders [time in minutes]"
    echo "        reminders show"
    echo "        reminders clear"
    exit 1
fi

if [[ -z "${message}" ]]; then
    message="Your ${minutes} minutes are up!"
fi

createdAt=$(date +%s)
remindAt=$(date -d "+${minutes} minutes" +%H:%M)
unit="reminders-${minutes}m-${createdAt}"
remindersDir="${XDG_RUNTIME_DIR:-/tmp}/reminders"
messageFile="${remindersDir}/${unit}.message"
confirmation="You'll be reminded at ${remindAt}"
confirmationTitle="Reinder set for ${minutes} minutes"

mkdir -p "${remindersDir}"

if [[ -n "${message}" ]]; then
    printf "%s" "${message}" > "${messageFile}"
    confirmationTitle="${message} in ${minutes} minutes"
fi

systemd-run --user --quiet --collect --on-active="${minutes}m" --unit="${unit}" \
    bash -c 'notify-send -u critical "Reminder!" "$1" ; rm -f "$2"' bash "${message}" "${messageFile}"

notify-send "${confirmationTitle}" "${confirmation}"
