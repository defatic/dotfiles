#!/usr/bin/env bash

# Optimized for 12GB VRAM + 32GB RAM + Concurrent Requests
# Model: Qwen3.5-9B-Q6_K (~7.5GB VRAM)

MODEL_DIR=~/Downloads/models/Qwen3.5-9B-Q6_K
MMPROJ=~/Downloads/models/mmproj-F16.gguf

llama-server --host 127.0.0.1 \
    --port 8080 \
    --temp 1.0 \
    --top-p 0.95 \
    --top-k 20 \
    --min-p 0.00 \
    --alias "unsloth/Qwen3.5-9B-Q6_K" \
    --models-dir "${MODEL_DIR}" \
    --mmproj "${MMPROJ}" \

#     More options
#     --jinja \
#     --presence-penalty 1.1 \
#     --cache-type-k q8_0 \
#     --cache-type-v q8_0 \
#     -fa auto \
#     -ngl 9999 \
#     --threads 4 \
#     --threads-batch 16 \
#     --parallel 2 \
#     --cont-batching \
#     --timeout 600 \

# Change log
# Before     |   After
# -----------|------------
# -fa on     |   -fa auto
# -c 4096    |   None

