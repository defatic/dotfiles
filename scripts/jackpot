#!/usr/bin/env bash

commands="go view "

if [[ -n "$COMP_LINE" ]]; then
  pre="${COMP_LINE##* }"
  for c in ${commands}; do
      [[ -z "${pre}" || "${c}" != "${c#"${pre}"}" ]] && echo "$c"
  done
  exit
fi

case "$@" in
    go)
        pushd ~/repos/dotfiles/scripts/ 1>/dev/null 2>&1 || exit
        ./cmd_jackpot.go
        ;;
    view)
        pushd ~/programing/python/jackpotAnalyzer 1>/dev/null 2>&1 || exit
        uv run view.py
        ;;
    *)
        pushd ~/programing/python/jackpotAnalyzer 1>/dev/null 2>&1 || exit
        uv run main.py
        ;;
esac

popd 1>/dev/null 2>&1 || exit
